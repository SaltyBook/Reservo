<Window x:Class="Reservo.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservo – Anwendungsanleitung"
        Height="750"
        Width="1000"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.AppBackground}">

    <Grid Margin="24">

        <Border Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="5">

                    <!-- Überschrift -->
                    <TextBlock Text="Anwendungsanleitung"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" />

                    <TextBlock Text="Kurze Übersicht über die wichtigsten Funktionen von Reservo."
                               Margin="0,6,0,24"
                               FontSize="14"
                               Foreground="{StaticResource Brush.TextSecondary}" />

                    <!-- Mieterlisten -->
                    <TextBlock Text="Mieterlisten"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,20">
                        Die Mieterlisten zeigen die vorhandenen Mieter- und Reservierungsdaten.
                        Die einzelnen Angaben können direkt in der Tabelle bearbeitet werden.
                    </TextBlock>

                    <!-- Reservierungstabelle -->
                    <TextBlock Text="Reservierungstabelle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,8">
                        Die Tabelle enthält unter anderem Gruppenname, Gästezahl,
                        Kontaktdaten, An- und Abreise, Rechnungsinformationen und weitere
                        Angaben zur Reservierung.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,20">
                        Viele Werte können direkt in der Tabelle geändert werden.
                        Datumsangaben werden über ein Kalenderfeld bearbeitet.
                        Beim Feld „Kontakt“ steht eine Auswahlliste zur Verfügung.
                    </TextBlock>

                    <!-- Drag & Drop -->
                    <TextBlock Text="Neue Mieter per Drag &amp; Drop"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,8">
                        Neue Mieter bzw. Reservierungen können per Drag &amp; Drop
                        in die Reservierungstabelle übernommen werden.
                    </TextBlock>

                    <Border Background="#FFF8E1"
                            BorderBrush="#E5C85C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,20">

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="14">
                            <Run FontWeight="SemiBold"
                                 Text="Wichtig: " />
                            <Run Text="Für eine korrekte Übernahme muss der Text aus einer E-Mail von Gruppenhaus.de verwendet werden.
                                       Andere Textquellen können aufgrund einer abweichenden Formatierung möglicherweise nicht korrekt verarbeitet werden." />
                        </TextBlock>

                    </Border>

                    <!-- Tastenkürzel -->
                    <TextBlock Text="Tastenkürzel"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,12" />

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Strg + C"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Eintrag kopieren" />

                        <TextBlock Grid.Row="1"
                                   Text="Strg + X"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Eintrag ausschneiden" />

                        <TextBlock Grid.Row="2"
                                   Text="Strg + V"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Eintrag einfügen" />

                        <TextBlock Grid.Row="3"
                                   Text="F12"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Detailansicht ein- bzw. ausblenden" />

                    </Grid>

                    <!-- Detailansicht -->
                    <TextBlock Text="Detailansicht"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Margin="0,0,0,20">
                        Mit der Taste F12 kann die Detailansicht ein- bzw. ausgeblendet werden.
                        Die Detailansicht wird neben der Reservierungstabelle angezeigt.
                    </TextBlock>

                    <!-- Farben -->
                    <TextBlock Text="Farbkennzeichnungen"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,8,0,12" />

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <!-- Angebot -->
                        <Border Grid.Row="0"
                                Width="20"
                                Height="20"
                                Background="#FFFFE0"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Angebot"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Der Eintrag ist als Angebot gekennzeichnet."
                                   VerticalAlignment="Center" />

                        <!-- Vergangen -->
                        <Border Grid.Row="1"
                                Width="20"
                                Height="20"
                                Background="#E5E7EB"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Vergangen"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="Der Aufenthalt ist bereits vergangen."
                                   VerticalAlignment="Center" />

                        <!-- Storniert -->
                        <Border Grid.Row="2"
                                Width="20"
                                Height="20"
                                Background="#FEE2E2"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Storniert"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="Der Eintrag wurde storniert."
                                   VerticalAlignment="Center" />

                        <!-- Auswahl -->
                        <Border Grid.Row="3"
                                Width="20"
                                Height="20"
                                Background="#9FB8FF"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Auswahl"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Text="Der Eintrag ist aktuell ausgewählt."
                                   VerticalAlignment="Center" />

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>